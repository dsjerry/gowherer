    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "licenses:generate": "node ./scripts/generate-licenses.js",
    "prestart": "npm run licenses:generate",
    "preandroid": "npm run licenses:generate",
    "preios": "npm run licenses:generate",
    "preweb": "npm run licenses:generate"
  },
